# Publishes Call Notes to TestFlight.
#
# The App Store Connect details come from the environment, never from this file,
# because this repository is public. Set them before you run a lane:
#
#   export ASC_KEY_ID=...            # the key id of the .p8
#   export ASC_ISSUER_ID=...         # the issuer uuid of the account
#   export ASC_KEY_PATH=...          # the path to the .p8, which stays off git
#
#   fastlane mkapp                   # register the bundle id, create the app
#   fastlane up ipa:../build/export/InterviewRecorder.ipa
#   fastlane group                   # internal testers, no App Review
#   fastlane state                   # what TestFlight holds now
default_platform(:ios)

KEY_ID    = ENV.fetch("ASC_KEY_ID")
ISSUER_ID = ENV.fetch("ASC_ISSUER_ID")
KEY_PATH  = ENV.fetch("ASC_KEY_PATH")
BUNDLE    = ENV.fetch("ASC_BUNDLE", "com.dhl84.callnotes")
TEAM      = ENV.fetch("ASC_TEAM", "5C49Q9G3ML")

def key
  app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH, duration: 1200)
end

def connect!
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
end

# Registers the bundle id, which the API does allow.
#
# It cannot create the app record. Apple offers no POST on /v1/apps: the API
# answers "The resource 'apps' does not allow 'CREATE'". That step is web only,
# so the lane registers what it can and prints what to do by hand.
lane :mkapp do |o|
  connect!
  name = o[:name] || "Call Notes"
  if (existing = Spaceship::ConnectAPI::App.all.find { |a| a.bundle_id == BUNDLE })
    UI.success("APP_EXISTS #{existing.name} [#{existing.id}]")
    next
  end
  bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == BUNDLE }
  if bundle.nil?
    bundle = Spaceship::ConnectAPI::BundleId.create(
      name: name, identifier: BUNDLE, platform: "IOS", seed_id: TEAM)
    UI.success("BUNDLE_REGISTERED [#{bundle.id}]")
  else
    UI.message("BUNDLE_PRESENT [#{bundle.id}]")
  end
  UI.important("No app record yet. Apple allows no app creation through the API.")
  UI.important("Open https://appstoreconnect.apple.com/apps and press the plus button:")
  UI.important("  Platform          iOS")
  UI.important("  Name              #{name}")
  UI.important("  Primary language  English (U.K.)")
  UI.important("  Bundle ID         #{BUNDLE}")
  UI.important("  SKU               callnotes")
  UI.important("  User access       Full Access")
  UI.important("Then run: fastlane fixprofile")
end

# Makes the App Store provisioning profile that the export step needs.
lane :fixprofile do
  sigh(api_key: key, app_identifier: BUNDLE, force: true, output_path: "/tmp")
end

lane :up do |o|
  upload_to_testflight(api_key: key, ipa: o[:ipa],
                       skip_waiting_for_build_processing: true, skip_submission: true)
end

# An internal group needs no App Review, so a build reaches the phone at once.
#
# The group goes through the API directly. fastlane's create_beta_group sends
# publicLinkLimitEnabled, and Apple now refuses that field on an internal group.
lane :group do |o|
  connect!
  c = Spaceship::ConnectAPI.tunes_request_client
  app = Spaceship::ConnectAPI::App.find(BUNDLE)
  email = o[:email] or UI.user_error!("pass email:you@example.com")
  groups = c.get("v1/apps/#{app.id}/betaGroups").body["data"] || []
  group = groups.find { |g| g.dig("attributes", "name") == "Family" }
  gid = group && group["id"]
  unless gid
    gid = c.post("v1/betaGroups", { data: { type: "betaGroups",
      attributes: { name: "Family", isInternalGroup: true, hasAccessToAllBuilds: true },
      relationships: { app: { data: { type: "apps", id: app.id } } } } }).body.dig("data", "id")
    UI.success("GROUP_CREATED Family [#{gid}]")
  else
    UI.message("GROUP_PRESENT Family [#{gid}]")
  end
  tester = Spaceship::ConnectAPI::BetaTester.all(filter: { email: email }).first
  UI.user_error!("#{email} is not a tester on this account") unless tester
  begin
    c.post("v1/betaGroups/#{gid}/relationships/betaTesters",
           { data: [{ type: "betaTesters", id: tester.id }] })
    UI.success("ADDED #{email}")
  rescue => e
    UI.message("add note: #{e.message[0, 160]}")
  end
end

lane :state do
  connect!
  app = Spaceship::ConnectAPI::App.find(BUNDLE)
  builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5)
  UI.message("APP #{app.name} [#{app.id}] builds=#{builds.size}")
  builds.each do |b|
    UI.message("BUILD #{b.pre_release_version&.version}(#{b.version}) state=#{b.processing_state}")
  end
end

# Shows what App Store Connect holds for the app, to explain a refused upload.
lane :probe do
  connect!
  c = Spaceship::ConnectAPI.tunes_request_client
  app = Spaceship::ConnectAPI::App.find(BUNDLE)
  UI.user_error!("no app record for #{BUNDLE}") unless app
  a = c.get("v1/apps/#{app.id}").body["data"]["attributes"]
  UI.message("RECORD id=#{app.id} name=#{a['name']} bundle=#{a['bundleId']} sku=#{a['sku']}")
  (c.get("v1/apps/#{app.id}/appStoreVersions").body["data"] || []).each do |v|
    UI.message("VERSION #{v.dig('attributes','versionString')} #{v.dig('attributes','platform')} #{v.dig('attributes','appStoreState')}")
  end
end
